# Copy to .env at the repo root and fill in.
# Obtain a connection URI from an NWC-compatible wallet (Alby, Mutiny,
# Cashu.me, Coinos, or a self-hosted NWC bridge in front of LND/CLN).
NWC_CONNECTION_URI=nostr+walletconnect://your-wallet-pubkey?relay=wss://relay.getalby.com/v1&secret=hex-secret

# Hard timeout for a single pay_invoice round-trip. On timeout the adapter
# calls lookup_invoice before deciding failure, so this value does not need
# to cover settlement latency.
NWC_TIMEOUT_SECONDS=60

# Floor for the max-fee budget in millisats. The adapter uses max(this, 1% of
# amount) at pay time, so keeping this small is safe for large payments.
NWC_MAX_FEE_MSAT=10000

# Set to false to reject LNURL and Lightning Address counterparties and
# require a pre-negotiated bolt11 invoice for every payment.
NWC_ALLOW_LNURL=true
