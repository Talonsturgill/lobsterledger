# Copy to .env at the repo root and fill in
CDP_API_KEY_ID=your-cdp-key-id
CDP_API_KEY_SECRET=your-cdp-key-secret
CDP_WALLET_SECRET=your-wallet-secret

# App config
LL_CDP_NETWORK=base-sepolia
LL_CDP_ACCOUNT_NAME=lobster-ledger-hot
# Uncomment to enable mainnet (you must also set LL_CDP_NETWORK=base)
# LL_ALLOW_MAINNET=1
# Optional paymaster for gasless
# LL_CDP_PAYMASTER_URL=https://api.developer.coinbase.com/rpc/v1/base/your-paymaster
# LL_CDP_RECEIPT_TIMEOUT=60
